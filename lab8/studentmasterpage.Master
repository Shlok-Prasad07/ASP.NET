<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="studentmasterpage.master.cs" Inherits="lab8.studentmasterpage" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <style>
        header{
            color: red;
            text-align: center;
            font-size: 30px;
            margin:0;
            background-color: aqua;
            width:100%;
        }

        h1{
            margin:0;
        }

        footer{
            position:absolute;
            bottom:0;
            color: white;
            width:100%;
            text-align:center;
            background-color:black;
        }

        #nav{
            background-color:black;
            padding:5px;
            text-align:center;
            
        }

        ul{
            list-style-type: none;
            margin:0;
            padding:0;
            overflow: hidden;
            background-color:black;
            
        }
        li {
            display:inline;
            font-size:20px;
        }

        a{
            text-decoration:none;
            margin-left:20px;
        }

        li a{
            color:white;
            text-align:center;
            padding: 14px 90px;
            text-decoration: none;
        }

        li a:hover{
            background-color:lightgreen;
        }
    </style>
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div>
            <div>
                <header>
                    <h1>Student Portal</h1>
                </header>
            </div>

            <div>
                <footer>
                     <h1 class="fot">Student Portal</h1>
                </footer>
            </div>

            <nav id="nav">
                <ul>
                    <li><a href="home.aspx">Home</a></li>
                    <li><a href="aboutus.aspx">About Us</a></li>
                    <li><a href="contactus.aspx">Contact Us</a></li>
                    <li><a href="moredetail.aspx">More detail</a></li>
                </ul>
            </nav>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
